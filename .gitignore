# Cloned upstream sources — read-only study copies, never committed.
# They belong to their own projects and would bloat this repo's history.
upstream/*
!upstream/README.md
!upstream/repos.txt

# GSD planning workspace — session-local codebase maps and planning state,
# regenerable via /gsd-map-codebase; not part of the repo's public record.
.planning/

# OS / editor noise
.DS_Store
Thumbs.db
.vscode/
.idea/
# Downloaded papers — read-only study copies, never committed.
# Copyright belongs to the publishers; refetchable from each note's arxiv/doi frontmatter.
refs/pdf/*
!refs/pdf/.gitkeep
__pycache__/
